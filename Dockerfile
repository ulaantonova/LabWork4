# 1. Вказуємо "фундамент" (базовий образ). 
# Python ідеально підходить для алгоритмів ШІ та обробки даних.
FROM python:3.9-slim

# 2. Створюємо папку всередині віртуального судна (контейнера)
WORKDIR /maritime_system

# 3. Копіюємо файл зі списком потрібних бібліотек (якщо він у вас є)
# Якщо файлу немає, Docker просто пропустить цей крок або видасть помилку.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Копіюємо всі ваші скрипти та коди автопілота в контейнер
COPY . .

# 5. Налаштовуємо змінні середовища (наприклад, тип судна)
ENV SHIP_TYPE="Cargo_Vessel"
ENV AUTOPILOT_LEVEL="Full_Autonomous"

# 6. Відкриваємо порт для передачі навігаційних даних (наприклад, 8080)
EXPOSE 8080

# 7. Команда, яка запустить систему при старті контейнера
# Замініть "main.py" на назву вашого головного файлу
CMD ["python", "main.py"]